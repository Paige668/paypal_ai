# Server-only PayPal Sandbox credentials. Never expose the secret to the browser.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Registered webhook ID from this Sandbox app; this is not the Client ID.
PAYPAL_WEBHOOK_ID=
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/paytrace.sqlite
# Read only for one-time migration when the SQLite database is empty.
ORDER_STORE_PATH=./data/orders.json
# Local demo controls are denied unless explicitly enabled.
DEMO_MODE=false
# Application-defined reconciliation grace period; this is not a PayPal SLA.
RECONCILIATION_GRACE_MS=60000
# Optional. When absent, investigation returns a grounded rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_MS=60000

